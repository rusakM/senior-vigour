{
    "name": "senior-vigour-backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "tsc --module esnext && npm run copy-files",
        "copy-files": "copyfiles -u 1 \"src/assets/**/*\" dist",
        "debug": "cross-env NODE_ENV=test nodemon --watch 'src/**/*.ts' --ext ts --exec tsx src/index.ts",
        "deploy": "node dist/index.js",
        "init": "npm install",
        "lint": "eslint ./**/*.ts --quiet",
        "refresh": "rm -rf ./node_modules ./dist ./package-lock.json && npm install",
        "start": "npm run lint && npm run debug",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "author": "Mateusz Rusak",
    "license": "ISC",
    "dependencies": {
        "@sentry/node": "^10.47.0",
        "@sentry/profiling-node": "^10.47.0",
        "cors": "^2.8.6",
        "countries-and-timezones": "^3.8.0",
        "cross-spawn": "^7.0.6",
        "date-fns": "^4.1.0",
        "dotenv": "^17.4.1",
        "ejs": "^6.0.1",
        "eslint": "^10.2.0",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "iso-3166-2": "^1.0.0",
        "joi": "^18.1.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.4.1",
        "multer": "^2.1.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^9.0.3",
        "nodemon": "^3.1.14",
        "redis": "^6.1.0",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/cross-spawn": "^6.0.6",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.20.3",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.0",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "cross-env": "^10.1.0",
        "globals": "^17.5.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    }
}
